---
import Layout from "../layouts/Layout.astro";
import { agent, stats } from "../data/site";
const usd = (n: number) => n.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
const usdM = (n: number) => `$${(n / 1e6).toFixed(1)}M`;
const services = [
  ["Accessibility-first home search", "Single-level living, zero-step entries, wide doorways, roll-in showers, and room for equipment — screened before you ever tour."],
  ["Sensory-friendly considerations", "Quiet streets, traffic and noise levels, lighting, fenced yards, and safe layouts for kids who wander or need a calm retreat."],
  ["Schools, therapy & care nearby", "We map commutes to IEP-supportive schools, therapy providers, pediatric specialists, and respite care so daily life works."],
  ["Showings on your family's terms", "Shorter, scheduled, low-stimulation tours, virtual previews first, and patience when plans change at the last minute."],
  ["Modifications & funding guidance", "Connections to contractors, OT home assessments, and programs that may help fund ramps, lifts, and other adaptations."],
  ["Planning for the long term", "Thinking ahead about guardianship, special-needs trusts, and housing that grows with your child — alongside the right professionals."],
];
---
<Layout>
<header class="sticky top-0 z-10 bg-cream/90 backdrop-blur border-b border-black/5">
  <nav class="max-w-6xl mx-auto flex items-center justify-between px-5 py-3">
    <a href="#" class="font-serif text-xl font-bold text-sage-dark">Rachel Porter</a>
    <ul class="hidden md:flex gap-6 text-sm">
      <li><a href="#about" class="hover:text-clay">About</a></li><li><a href="#services" class="hover:text-clay">Services</a></li>
      <li><a href="#stats" class="hover:text-clay">Results</a></li><li><a href="#contact" class="hover:text-clay">Contact</a></li>
    </ul>
    <a href="#contact" class="rounded-full bg-clay text-white px-4 py-2 text-sm font-semibold hover:opacity-90">Let's talk</a>
  </nav>
</header>
<main id="main">
  <section class="max-w-6xl mx-auto px-5 py-16 md:py-24 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <p class="uppercase tracking-widest text-sage-dark text-sm font-semibold">Central Virginia · Keeton & Co Real Estate</p>
      <h1 class="font-serif text-4xl md:text-6xl font-bold mt-3 leading-tight">A home that fits <span class="text-clay">every</span> member of your family.</h1>
      <p class="mt-6 text-lg text-ink/80">I'm Rachel — a REALTOR® and a mom to a son with special needs. I help special-needs families buy and sell homes with the patience, planning, and understanding I'd want for my own.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#contact" class="rounded-full bg-sage-dark text-white px-6 py-3 font-semibold hover:opacity-90">Start the conversation</a>
        <a href={`tel:${agent.phone.replace(/\D/g, "")}`} class="rounded-full border-2 border-sage-dark text-sage-dark px-6 py-3 font-semibold">Call {agent.phone}</a>
      </div>
    </div>
    <div class="relative">
      <div class="absolute -inset-3 rounded-[2rem] bg-sage/20 rotate-2"></div>
      <img src="/images/rachel-porter-headshot.jpg" alt="Rachel Porter, REALTOR®" class="relative rounded-[2rem] w-full max-w-md mx-auto aspect-[4/5] object-cover shadow-xl" />
    </div>
  </section>

  <section id="about" class="bg-white py-20">
    <div class="max-w-3xl mx-auto px-5">
      <h2 class="font-serif text-3xl md:text-4xl font-bold">Why families like ours need a different kind of Realtor</h2>
      <div class="mt-6 space-y-4 text-lg text-ink/85">
        <p>I'm a single mom to two boys. My son Wyatt has special needs, and he's taught me that "a good house" means something different for every family — the right layout, the right school, a quiet street, a therapist who's not an hour away.</p>
        <p>I've been with {agent.brokerage} since {agent.withFirmSince} and have helped {stats.careerClosings}+ families buy and sell homes across Goochland, Henrico, Richmond, and the surrounding counties.</p>
        <p class="rounded-lg border border-dashed border-clay/60 bg-clay/5 p-4 text-base">[PLACEHOLDER — Rachel: add your own words here. Your story with Wyatt, what you've learned, and why you chose this focus. Only share what you're comfortable with.]</p>
      </div>
    </div>
  </section>

  <section id="services" class="py-20">
    <div class="max-w-6xl mx-auto px-5">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center">How I help special-needs families</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(([t, d]) => (
          <article class="rounded-2xl bg-white p-6 shadow-sm border border-black/5">
            <h3 class="font-serif text-xl font-bold text-sage-dark">{t}</h3><p class="mt-3 text-ink/80">{d}</p>
          </article>))}
      </div>
    </div>
  </section>

  <section id="stats" class="bg-sage-dark text-white py-16">
    <div class="max-w-6xl mx-auto px-5 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div><p class="font-serif text-4xl font-bold">{stats.careerClosings}</p><p class="mt-1 text-white/80">homes sold, career</p></div>
      <div><p class="font-serif text-4xl font-bold">{stats.closings12mo}</p><p class="mt-1 text-white/80">closings, last 12 months</p></div>
      <div><p class="font-serif text-4xl font-bold">{usdM(stats.volume2026YTD)}</p><p class="mt-1 text-white/80">sold in 2026</p></div>
      <div><p class="font-serif text-4xl font-bold">{usdM(stats.careerVolumeSince2019)}</p><p class="mt-1 text-white/80">sales volume since 2019</p></div>
    </div>
    <p class="text-center text-white/60 text-xs mt-6">Keeton & Co transaction records as of {stats.asOf}.</p>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-5">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center">What families say</h2>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        {[1,2,3].map(() => (<blockquote class="rounded-2xl bg-white p-6 border border-dashed border-clay/60 text-ink/60 italic">[PLACEHOLDER — add a real client review with their permission, e.g. from Zillow or Google.]</blockquote>))}
      </div>
    </div>
  </section>

  <section id="contact" class="bg-white py-20">
    <div class="max-w-5xl mx-auto px-5 grid md:grid-cols-2 gap-10">
      <div>
        <h2 class="font-serif text-3xl md:text-4xl font-bold">Let's talk about your family's next home</h2>
        <p class="mt-4 text-lg text-ink/80">No pressure. Tell me a little about what your family needs, and I'll reach out the way that works best for you.</p>
        <ul class="mt-6 space-y-2">
          <li><strong>Phone:</strong> <a class="underline" href={`tel:${agent.phone.replace(/\D/g, "")}`}>{agent.phone}</a></li>
          <li><strong>Email:</strong> <a class="underline" href={`mailto:${agent.email}`}>{agent.email}</a></li>
          <li><strong>Office:</strong> {agent.office}</li>
        </ul>
      </div>
      <form id="lead-form" class="space-y-4">
        <label class="block"><span class="font-semibold">Name *</span><input required name="name" class="mt-1 w-full rounded-lg border border-black/20 p-3" /></label>
        <div class="grid grid-cols-2 gap-4">
          <label class="block"><span class="font-semibold">Email</span><input type="email" name="email" class="mt-1 w-full rounded-lg border border-black/20 p-3" /></label>
          <label class="block"><span class="font-semibold">Phone</span><input type="tel" name="phone" class="mt-1 w-full rounded-lg border border-black/20 p-3" /></label>
        </div>
        <label class="block"><span class="font-semibold">I'm looking to</span>
          <select name="looking_to" class="mt-1 w-full rounded-lg border border-black/20 p-3"><option value="buy">Buy</option><option value="sell">Sell</option><option value="both">Buy & sell</option><option value="not_sure">Not sure yet</option></select></label>
        <label class="block"><span class="font-semibold">Anything your family needs in a home? (optional)</span><textarea name="family_needs" rows="3" class="mt-1 w-full rounded-lg border border-black/20 p-3" placeholder="e.g. single level, fenced yard, near a specific school or therapy center"></textarea></label>
        <label class="block"><span class="font-semibold">Best way to reach you</span>
          <select name="preferred_contact" class="mt-1 w-full rounded-lg border border-black/20 p-3"><option value="text">Text</option><option value="phone">Phone call</option><option value="email">Email</option></select></label>
        <button class="rounded-full bg-clay text-white px-6 py-3 font-semibold hover:opacity-90">Send</button>
        <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
      </form>
    </div>
  </section>
</main>
<footer class="py-10 text-center text-sm text-ink/60 px-5">
  <img src="/images/keeton-logo.png" alt="Keeton & Co Real Estate" class="h-10 mx-auto mb-3" />
  <p>{agent.name}, REALTOR® · VA License #{agent.licenseVA} · {agent.office}</p>
  <p class="mt-1">Equal Housing Opportunity. Licensed in Virginia. Brokered by <a class="underline" href={agent.brokerageUrl}>Keeton & Co Real Estate</a>.</p>
</footer>
<script>
  import { submitLead } from "../lib/leads";
  const form = document.getElementById("lead-form") as HTMLFormElement;
  const status = document.getElementById("form-status")!;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!data.email && !data.phone) { status.textContent = "Please add an email or phone so I can reach you."; return; }
    status.textContent = "Sending…";
    const err = await submitLead(data);
    status.textContent = err ? "Sorry, something went wrong. Please call or email me directly." : "Thank you! I'll be in touch soon.";
    if (!err) form.reset();
  });
</script>
</Layout>
