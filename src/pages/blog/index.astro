---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";
const posts = await getPosts();
---
<Layout title="Blog | Rachel Porter, The Special-Needs Family Realtor" description="Guides and stories for special-needs families buying and selling homes in Richmond and Central Virginia.">
  <section class="max-w-5xl mx-auto px-5 py-16">
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-center">The Blog</h1>
    <p class="text-center mt-3 text-ink/70 mb-10">Home buying and selling for special-needs families in Central Virginia.</p>
    <PostList posts={posts} />
  </section>
</Layout>
