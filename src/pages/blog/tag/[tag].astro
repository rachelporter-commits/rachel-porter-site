---
import Layout from "../../../layouts/Layout.astro";
import PostList from "../../../components/PostList.astro";
import { getPosts, slugify } from "../../../lib/posts";
export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((t) => ({ params: { tag: slugify(t) }, props: { tag: t, posts: posts.filter((p) => p.data.tags.includes(t)) } }));
}
const { tag, posts } = Astro.props;
---
<Layout title={`#${tag} | Rachel Porter blog`} description={`Posts tagged ${tag}.`}>
  <section class="max-w-5xl mx-auto px-5 py-16">
    <h1 class="font-serif text-4xl font-bold text-center mb-10">Posts tagged “{tag}”</h1>
    <PostList posts={posts} />
    <p class="text-center mt-10"><a href="/blog/" class="underline">All posts</a></p>
  </section>
</Layout>
