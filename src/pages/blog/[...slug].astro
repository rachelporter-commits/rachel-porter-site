---
import Layout from "../../layouts/Layout.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import { render } from "astro:content";
import { getPosts, fmt, slugify } from "../../lib/posts";
import { person, brokerage, videoSchema } from "../../lib/schema";
import { SITE_URL } from "../../data/site";
export async function getStaticPaths() {
  return (await getPosts()).map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = `${SITE_URL}/blog/${post.id}/`;
const schema: object[] = [{ "@type": "BlogPosting", headline: d.title, description: d.description, datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(), url, mainEntityOfPage: url, keywords: d.tags.join(", "),
  image: SITE_URL + (d.heroImage ?? "/images/rachel-porter-headshot.jpg"), author: { "@id": person["@id"] }, publisher: { "@id": brokerage["@id"] } }];
if (d.video) schema.push(videoSchema({ title: d.title, description: d.description, url: d.video, pubDate: d.pubDate }));
---
<Layout title={`${d.title} | Rachel Porter`} description={d.description} image={d.heroImage} type="article" schema={schema}>
  <article class="max-w-3xl mx-auto px-5 py-16">
    <p class="text-sm text-ink/60"><a href="/blog/" class="underline">Blog</a> · <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>{d.draft && <span class="ml-2 rounded bg-clay/20 px-2 text-clay font-semibold">DRAFT – not published</span>}</p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold mt-2">{d.title}</h1>
    <p class="mt-3 flex flex-wrap gap-2">{d.tags.map((t) => <a href={`/blog/tag/${slugify(t)}/`} class="text-xs rounded-full bg-sage/15 text-sage-dark px-3 py-1">#{t}</a>)}</p>
    {d.heroImage && <img src={d.heroImage} alt={d.heroAlt ?? ""} class="rounded-2xl mt-8 w-full" />}
    {d.video && <VideoEmbed url={d.video} title={d.title} />}
    <div class="prose prose-lg mt-8 max-w-none prose-headings:font-serif prose-a:text-sage-dark"><Content components={{ VideoEmbed }} /></div>
    <aside class="mt-12 rounded-2xl bg-white p-6 border border-black/5 flex gap-4 items-center">
      <img src="/images/rachel-porter-headshot.jpg" alt="" class="h-16 w-16 rounded-full object-cover" loading="lazy" />
      <p>Written by <strong>Rachel Porter</strong>, REALTOR® with Keeton & Co Real Estate. <a href="/#contact" class="underline">Talk with Rachel</a>.</p>
    </aside>
  </article>
</Layout>
