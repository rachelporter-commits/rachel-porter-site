---
// Usage (also in .mdx posts): <VideoEmbed url="https://youtu.be/XXXX" title="Tour of an accessible ranch home" />
import { parseVideo } from "../lib/video";
const { url, title = "Video" } = Astro.props as { url: string; title?: string };
const v = parseVideo(url);
const tall = v.kind === "tiktok";
---
<figure class={`not-prose my-6 mx-auto ${tall ? "max-w-sm" : "w-full"}`}>
  <div class={`relative overflow-hidden rounded-2xl bg-black ${tall ? "aspect-[9/16]" : "aspect-video"}`}>
    {v.kind === "youtube" ? (
      <button type="button" class="lite-yt group absolute inset-0 w-full h-full" data-embed={v.embed} aria-label={`Play video: ${title}`}>
        <img src={v.thumb} alt="" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
        <span class="absolute inset-0 m-auto h-16 w-24 rounded-2xl bg-red-600/90 group-hover:bg-red-600 grid place-items-center" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-8 w-8 fill-white"><path d="M8 5v14l11-7z"/></svg></span>
      </button>
    ) : v.kind === "file" ? (
      <video controls preload="none" playsinline class="absolute inset-0 w-full h-full" title={title}><source src={v.embed} /></video>
    ) : v.embed ? (
      <iframe src={v.embed} title={title} loading="lazy" class="absolute inset-0 w-full h-full" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
    ) : (
      <a href={url} class="absolute inset-0 grid place-items-center text-white underline">Watch: {title}</a>
    )}
  </div>
</figure>
<script>
  document.querySelectorAll<HTMLButtonElement>(".lite-yt").forEach((b) =>
    b.addEventListener("click", () => {
      const f = document.createElement("iframe");
      f.src = b.dataset.embed!; f.title = b.getAttribute("aria-label") || "Video";
      f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen"; f.allowFullscreen = true;
      f.className = "absolute inset-0 w-full h-full";
      b.replaceWith(f);
    }, { once: true }));
</script>
